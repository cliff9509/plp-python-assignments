1. class Book:
    def __init__(self, title, author, isbn):
        self.title = title
        self.author = author
        self.isbn = isbn

    def display_info(self):
        print(f"Title: {self.title}")
        print(f"Author: {self.author}")
        print(f"ISBN: {self.isbn}")

    def read(self):
        print(f"Reading '{self.title}'...")

class EBook(Book):
    def __init__(self, title, author, isbn, file_format, file_size):
        super().__init__(title, author, isbn)
        self.file_format = file_format
        self.file_size = file_size

    def display_info(self):
        super().display_info()
        print(f"File Format: {self.file_format}")
        print(f"File Size: {self.file_size}")

    def read_on_device(self, device):
        print(f"Reading '{self.title}' on {device}...")

book1 = Book("The Hitchhiker's Guide to the Galaxy", "Douglas Adams", "978-0345391803")
book2 = Book("Pride and Prejudice", "Jane Austen", "978-0141439518")

ebook1 = EBook("Foundation", "Isaac Asimov", "978-0553803712", "EPUB", "2.1 MB")
ebook2 = EBook("Dune", "Frank Herbert", "978-0441013593", "MOBI", "3.5 MB")

print("--- Book 1 ---")
book1.display_info()
book1.read()

print("\n--- Book 2 ---")
book2.display_info()
book2.read()

print("\n--- EBook 1 ---")
ebook1.display_info()
ebook1.read()
ebook1.read_on_device("Kindle")

print("\n--- EBook 2 ---")
ebook2.display_info()
ebook2.read()
ebook2.read_on_device("Tablet")

2.class Vehicle:
    def move(self):
        print("Vehicle is moving...")

class Car(Vehicle):
    def move(self):
        print("Driving 🚗")

class Plane(Vehicle):
    def move(self):
        print("Flying ✈️")

class Boat(Vehicle):
    def move(self):
        print("Sailing 🛥️")

class Animal:
    def move(self):
        print("Animal is moving...")

class Dog(Animal):
    def move(self):
        print("Running 🐕")

class Bird(Animal):
    def move(self):
        print("Flying 🐦")

class Fish(Animal):
    def move(self):
        print("Swimming 🐠")

# Create instances of different vehicles
car = Car()
plane = Plane()
boat = Boat()

# Create instances of different animals
dog = Dog()
bird = Bird()
fish = Fish()

# Demonstrate the polymorphic behavior of the move() method
print("--- Vehicles ---")
car.move()
plane.move()
boat.move()

print("\n--- Animals ---")
dog.move()
bird.move()
fish.move()
